class Solution {
public:
    int search(vector<int>& nums, int target) {
        int left = 0, right = nums.size() - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (nums[mid] == target)
                return mid;

            if (nums[left] <= nums[mid]) {
                if (nums[left] <= target && target < nums[mid])
                    right = mid - 1;
                else
                    left = mid + 1;
            } else {
                if (nums[mid] < target && target <= nums[right])
                    left = mid + 1;
                else
                    right = mid - 1;
            }
        }

        return -1;
    }
};
**Intuition:**  
Even after rotation, one half of the array is always sorted.  
Use this property to decide which half may contain the target.

**Algorithm:**  
Apply binary search and identify the sorted half using `left` and `mid`.  
Check whether the target lies in that range, then discard the other half.

**Complexity:**  
Time: **O(log n)**  
Space: **O(1)**
